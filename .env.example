# Copy to `.env` and edit. Every value below is optional -- the defaults shown
# are what the system uses if the variable is absent, and the project runs with
# no .env file at all.
#
# .env is gitignored. Never commit real credentials.
# Read by src/config.py; a real environment variable always overrides this file.

# ---------------------------------------------------------------- embeddings
# auto        try sentence-transformers, fall back to TF-IDF (default)
# tfidf       skip the slow torch import entirely -- use this on demo day
# transformer hard-fail if sentence-transformers is unavailable
EMBEDDER_BACKEND=tfidf
EMBEDDER_MODEL=all-MiniLM-L6-v2

# Override the per-backend default similarity threshold. Leave unset to use
# EntityResolver.DEFAULT_THRESHOLD (0.40 for tfidf, 0.72 for transformer).
# SIMILARITY_THRESHOLD=0.45

# ---------------------------------------------------------------- money
# Every price is converted to this before ranking or storage. See src/money.py.
BASE_CURRENCY=INR

# ---------------------------------------------------------------- live sources
# Register a Production keyset at https://developer.ebay.com
# With these unset, the system serves from the synthetic market and says so.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# ---------------------------------------------------------------- http
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE=0.5
HTTP_RATE_LIMIT_PER_SEC=5.0

# ---------------------------------------------------------------- caching
CACHE_ENABLED=1
CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------- synthetic market
# Changing the seed changes every simulated price, so a backfilled history
# generated with a different seed is a DIFFERENT history. Keep it fixed.
SYNTHETIC_SEED=20260804
SYNTHETIC_DAILY_VOLATILITY=0.012

# ---------------------------------------------------------------- logging
LOG_LEVEL=INFO
# text = human readable, json = one object per line for a log aggregator
LOG_FORMAT=text

# ---------------------------------------------------------------- api
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=*

# ---------------------------------------------------------------- paths
# DB_PATH=data/aggregator.db
